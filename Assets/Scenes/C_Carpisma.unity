  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.77, g: 0.81, b: 0.8, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 21
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 0
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.12
  m_Text: "45 saniye hayatta kal. Mavi topa dokunma.\n\nA / D veya \u2190 / \u2192 ile y\xFCr\xFC ve kalkan y\xF6n\xFCn\xFC se\xE7.\nE'ye k\u0131sa bas\u0131p b\u0131rak: k\u0131sa bir parry penceresi a\xE7\u0131l\u0131r.\nE'yi uzun tutmak savunma sa\u011Flamaz.\n\nS\xFCre dolunca yeni bir parry ile topu y\xFCkle;\nortadaki \u0131\u015F\u0131kl\u0131 al\u0131c\u0131ya g\xF6nder ve a\xE7\u0131lan kap\u0131ya y\xFCr\xFC."
